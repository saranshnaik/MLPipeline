# Copy this file to .env (git-ignored) and fill in the values.
# Never commit real credentials.

# --- MLflow on DagsHub (required for training and for loading the registry model) ---
# DagsHub exposes MLflow at https://dagshub.com/<username>/<repo>.mlflow
MLFLOW_TRACKING_URI=https://dagshub.com/<username>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=
# DagsHub access token (account settings -> tokens)
MLFLOW_TRACKING_PASSWORD=

# --- API (optional) ---
# Model to serve: models:/<name>@<alias>, models:/<name>/<version>, or a path to a .pkl.
# Defaults to the local model/model.pkl when unset.
# MODEL_URI=models:/telco-churn@champion
# Comma-separated browser origins allowed by CORS (no trailing slash).
# ALLOWED_ORIGINS=http://localhost:3000

# --- Training (optional) ---
# Render deploy hook; train.py calls it after promoting a new champion.
# RENDER_DEPLOY_HOOK_URL=
